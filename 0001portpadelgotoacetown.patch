+    height: 40px;
+    border-radius: 50%;
+    background: var(--accent-soft);
+    color: var(--accent);
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    font-weight: 800;
+    font-size: .9rem;
+    flex-shrink: 0;
+}
+
+.partner-host-name {
+    font-size: .92rem;
+    font-weight: 700;
+    color: var(--white);
+}
+
+.level-badge {
+    font-size: .7rem;
+    font-weight: 700;
+    padding: 4px 10px;
+    border-radius: var(--r-pill);
+    white-space: nowrap;
+}
+
+.level-badge.مبتدئ {
+    background: rgba(100, 180, 255, .12);
+    color: #64b4ff;
+}
+
+.level-badge.متوسط {
+    background: var(--accent-soft);
+    color: var(--accent);
+}
+
+.level-badge.محترف {
+    background: rgba(255, 193, 83, .12);
+    color: #ffc453;
+}
+
+.partner-card-meta {
+    display: flex;
+    flex-direction: column;
+    gap: 8px;
+}
+
+.partner-card-meta .meta-row {
+    display: flex;
+    align-items: center;
+    gap: 8px;
+    font-size: .84rem;
+    color: var(--text-muted);
+}
+
+.partner-card-meta .meta-row i,
+.partner-card-meta .meta-row i {
+    color: var(--accent);
+    font-size: 15px;
+    width: 16px;
+}
+
+.partner-need-badge {
+    display: inline-flex;
+    align-items: center;
+    gap: 6px;
+    align-self: flex-start;
+    background: var(--bg-elevated);
+    border: 1px solid var(--border-glass);
+    border-radius: var(--r-pill);
+    padding: 5px 12px;
+    font-size: .78rem;
+    color: var(--light-gray);
+    font-weight: 600;
+}
+
+.partner-need-badge i {
+    font-size: 15px;
+    color: var(--accent);
+}
+
+.partner-card-notes {
+    font-size: .82rem;
+    color: var(--text-muted);
