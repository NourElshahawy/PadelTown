+      <div className="wizard-review-list">
+        {rows.map((row) => (
+          <div className="wizard-review-row" key={row.label}>
+            <span className="wizard-review-label">{row.label}</span>
+            <span className="wizard-review-value">{row.value || "—"}</span>
+          </div>
+        ))}
+      </div>
+    </div>
+  );
+}
