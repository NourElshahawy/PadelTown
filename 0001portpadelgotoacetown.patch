+    animation: td-rail-pulse 2.4s ease-in-out infinite;
+}
+
+@keyframes td-rail-pulse {
+
+    0%,
+    100% {
+        opacity: .25
+    }
+
+    50% {
+        opacity: .6
+    }
+}
+
+@keyframes td-blink {
+
+    0%,
+    100% {
+        opacity: 1
+    }
+
+    50% {
+        opacity: .25
+    }
+}
+
+.td-section-title {
+    font-size: 16px;
+    font-weight: 800;
+    margin-bottom: 12px;
+}
+
+.td-empty {
