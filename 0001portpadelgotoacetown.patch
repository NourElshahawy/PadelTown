+    margin-inline: auto;
+    padding: 120px 20px;
+    display: flex;
+    position: relative;
+    width: 95%;
+}
+
+.td-page::before {
+    content: "";
+    position: absolute;
+    top: 0;
+    bottom: 0;
+    right: 6px;
+    width: 2px;
+    background: linear-gradient(to bottom, transparent, var(--td-border) 10%, var(--td-border) 90%, transparent);
+    opacity: .5;
