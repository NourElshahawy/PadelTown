+            <span className={`owner-status-badge ${v.status}`}>{v.status === "approved" ? "معتمد" : "قيد المراجعة"}</span>
+          </div>
+        ))}
+      </div>
+    </>
+  );
+}
+
+function StatCard({ label, value }) {
+  return (
+    <div className="owner-stat-card">
