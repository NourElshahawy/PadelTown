+            </div>
+            <p className="td-team-captain">الكابتن: {team.captainName}</p>
+            <div className="td-team-rating">
+              {"⭐".repeat(Math.round(team.rating || 0))}
+              {"☆".repeat(5 - Math.round(team.rating || 0))}
