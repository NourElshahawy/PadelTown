+}
+
+.players-stepper span {
+    min-width: 60px;
+    text-align: center;
+    font-weight: 700;
+    color: var(--white);
+}
+
+.form-success-card {
+    max-width: 480px;
+    margin: 60px auto;
+    text-align: center;
+    background: var(--bg-secondary);
+    border: 1px solid var(--accent);
+    border-radius: var(--r-lg);
+    padding: 40px 30px;
+}
+
+.form-success-card i {
+    font-size: 48px;
+    color: var(--accent);
+}
+
+.form-success-card h3 {
+    color: var(--white);
+    margin: 14px 0 8px;
+}
+
+.form-success-card p {
+    color: var(--text-muted);
+    margin-bottom: 24px;
+}
+
+/* ===== Detail page ===== */
+.request-detail-grid {
+    display: grid;
+    grid-template-columns: 1fr 340px;
+    gap: 28px;
+    align-items: flex-start;
+}
+
+.request-detail-card {
+    background: var(--bg-secondary);
+    border: 1px solid var(--border-glass);
+    border-radius: var(--r-lg);
+    padding: 28px;
+}
+
+.request-host-row {
+    display: flex;
+    align-items: center;
+    gap: 14px;
+    margin-bottom: 20px;
+    padding-bottom: 20px;
+    border-bottom: 1px solid var(--border-glass);
+}
+
+.request-host-row .partner-avatar {
+    width: 52px;
