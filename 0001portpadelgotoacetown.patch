@@ -0,0 +1,568 @@
+.container {
+    max-width: 90%;
+}
+.main-container{
+    height: 50vh;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    gap: 20px;
+    flex-direction: column;
+}
+.eyebrow {
+    display: inline-flex;
+    align-items: center;
+    gap: 8px;
+    font-family: var(--font-body);
+    font-size: 0.78rem;
+    font-weight: 600;
+    letter-spacing: 0.16em;
+    text-transform: uppercase;
+    color: var(--accent);
+}
+
+.eyebrow::before {
+    content: "";
+    width: 18px;
+    height: 2px;
+    background: var(--accent);
+    border-radius: 2px;
+}
+
+.section-title {
+    font-size: clamp(1.9rem, 3.2vw, 2.7rem);
+    color: var(--white);
+}
+
+.section-sub {
+    color: var(--text-muted);
+    font-size: 1.05rem;
+    max-width: 560px;
+}
+
+.text-accent {
+    color: var(--accent);
+}
+
+.accent-underline {
+    position: relative;
+    color: var(--accent);
+    white-space: nowrap;
+}
+
+.section {
+    padding: 50px 0;
+    position: relative;
+}
+
+@media (max-width: 991px) {
+    .section {
+        padding: 88px 0;
+    }
+}
+
+@media (max-width: 575px) {
+    .section {
+        padding: 64px 0;
+    }
+}
+
+.btn {
+    cursor: pointer;
+    font-family: var(--font-body);
+    font-weight: 600;
+    border-radius: var(--r-pill);
+    padding: 0.85rem 1.7rem;
+    border: 1px solid transparent;
+    transition: transform .35s var(--ease), box-shadow .35s var(--ease),
+        background .35s var(--ease), color .35s var(--ease), border-color .35s var(--ease);
+    display: inline-flex;
+    align-items: baseline;
+    justify-content: center;
+    gap: 0.5rem;
+    white-space: nowrap;
