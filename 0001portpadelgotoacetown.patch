+  return (
+    <div className="manage-section start-tournament-banner">
+      <h3>🏁 بدء البطولة</h3>
+      {canStart ? (
+        <>
+          <p>عدد الفرق ({tournament.teams.length}) جاهز لتوليد جدول المباريات. هذا الإجراء نهائي ويقفل التسجيل.</p>
