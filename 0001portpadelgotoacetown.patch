+/* ===== Tournament Wizard ===== */
+
+.wizard-section {
+    padding: 200px 0 40px;
+    min-height: 100vh;
+    display: flex;
+    justify-content: center;
+    align-items: center;
+}
+
+/* Progress pills */
+.wizard-steps {
+    display: flex;
+    align-items: center;
+    gap: 8px;
+    overflow-x: auto;
+    padding-bottom: 4px;
+}
+
+.wizard-step-pill {
+    display: flex;
+    align-items: center;
+    gap: 8px;
+    padding: 8px 14px;
+    border-radius: 999px;
+    background: var(--accent-color);
+    color: #888;
+    font-size: 14px;
+    white-space: nowrap;
+    flex-shrink: 0;
+    transition: all 0.2s ease;
+}
+
+.wizard-step-pill.active {
+    background: var(--accent-color, #0d6efd);
+    color: #fff;
+}
+
+.wizard-step-pill.done {
+    background: rgba(0, 214, 143, 0.15);
+    color: #1a7f37;
+}
+
+.wizard-step-num {
+    width: 22px;
+    height: 22px;
+    border-radius: 50%;
+    background: rgba(255, 255, 255, 0.25);
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    font-size: 12px;
+    flex-shrink: 0;
+}
+
+.wizard-step-pill:not(.active) .wizard-step-num {
+    background: rgba(0, 0, 0, 0.08);
+}
+
+/* Card */
+.wizard-card {
+    background: var(--accent-color);
+    border-radius: 16px;
+    box-shadow: 0 10px 28px rgba(0, 214, 143, .35);
+    padding: 20px;
+    margin: 24px 0;
+}
+
+.wizard-step-title {
+    display: flex;
+    align-items: center;
+    gap: 10px;
+    margin-bottom: 24px;
+    font-weight: 700;
+}
+
+.wizard-hint {
+    display: block;
+    color: #888;
+    margin-top: 6px;
+    font-size: 13px;
+}
+
+.wizard-error {
+    color: #d92d20;
+    margin-top: 12px;
+    font-size: 14px;
+}
+
+.form-control {
+    background: var(--accent-color);
+    border: 1px solid #e5e5e549;
+    margin-top: 10px;
+    color: #e5e5e5;
+}
+
+/* Radio pills (فردي / زوجي) */
+.radio-pills {
+    margin-top: 10px;
+    display: flex;
+    gap: 10px;
+}
+
+.radio-pill {
+    flex: 1;
+    padding: 12px;
+    border-radius: 10px;
+    border: 1.5px solid #e5e5e549;
+    color: #e5e5e5;
+    background: var(--accent-color);
+    cursor: pointer;
+    transition: all 0.2s ease;
+}
+
+.radio-pill.active {
+    border-color: var(--accent-color, #0d6efd);
+    background: rgba(13, 110, 253, 0.06);
+    font-weight: 600;
+}
+
+/* Team count stepper */
+.team-stepper {
+    display: flex;
+    align-items: center;
+    gap: 16px;
+    background: #121826;
+    border-radius: 10px;
+    padding: 10px 16px;
+    width: fit-content;
+    margin-top: 10px;
+}
+
+.team-stepper button {
+    width: 34px;
+    height: 34px;
+    border-radius: 50%;
+    border: none;
+    background: rgba(0, 214, 143, .35);
+    color: #e5e5e5;
+    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.1);
+    font-size: 18px;
+    cursor: pointer;
+}
+
+.team-stepper button:disabled {
+    opacity: 0.35;
+    cursor: not-allowed;
+}
+
+.team-stepper span {
+    min-width: 70px;
+    text-align: center;
+    font-weight: 700;
+}
+
+/* Preview strip on step 1 */
+.wizard-preview {
+    display: flex;
+    gap: 16px;
+    margin-top: 20px;
+    padding-top: 16px;
+    border-top: 1px dashed #eee;
+    color: #666;
+    font-size: 14px;
+}
+
+/* Court pick cards (step 2) */
+.court-pick-card {
+    position: relative;
+    width: 100%;
+    border: 1px solid var(--border-glass);
+    border-radius: var(--r-lg);
+    overflow: hidden;
+    background: transparent;
+    padding: 0;
+    cursor: pointer;
+    text-align: right;
+    transition: all 0.2s ease;
+}
+
+.court-pick-card.selected {
+    border-color: var(--accent-color, #0d6efd);
+    box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.12);
+}
+
+.court-pick-image {
+    height: 120px;
+    background-size: cover;
+    background-position: center;
+}
+
+.court-pick-body {
+    padding: 12px 14px;
+}
+
+.court-pick-body h6 {
+    font-size: 15px;
+    font-weight: 600;
+    margin-bottom: 4px;
+    color: #ddd;
+}
+
+.court-pick-meta {
+    display: flex;
+    gap: 12px;
+    color: #888;
+    font-size: 13px;
+    margin-top: 4px;
+}
+
+.court-pick-check {
+    position: absolute;
+    top: 10px;
+    left: 10px;
+    width: 26px;
+    height: 26px;
+    border-radius: 50%;
+    background: var(--accent-color, #0d6efd);
+    color: #fff;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    font-size: 12px;
+}
+
+/* Review step */
+.wizard-review-list {
+    display: flex;
+    flex-direction: column;
+    gap: 12px;
+}
+
+.wizard-review-row {
+    display: flex;
+    justify-content: space-between;
+    padding: 12px 14px;
+    box-shadow: 0 10px 28px rgba(0, 214, 143, 0.123);
+    border-radius: 10px;
+    font-size: 14px;
+}
+
+.wizard-review-label {
+    color: #888;
+}
+
+.wizard-review-value {
+    font-weight: 700;
+}
+
+/* Actions */
+.wizard-actions {
+    display: flex;
+    justify-content: space-between;
+    margin-top: 28px;
+    gap: 12px;
+}
+
+.wizard-actions .btn {
+    min-width: 130px;
+    align-items: center;
+}
+
+/* Mobile */
+@media (max-width: 576px) {
+    .wizard-section {
+        padding: 120px 0 40px;
+    }
+
+    .wizard-card {
+        padding: 16px;
+        border-radius: 12px;
+    }
+
+    .wizard-actions {
+        flex-direction: column-reverse;
+    }
+
+    .wizard-actions .btn {
+        width: 100%;
+    }
+}
+
+.review-modal-overlay {
+    position: fixed;
+    inset: 0;
+    background: rgba(0, 0, 0, 0.65);
+    backdrop-filter: blur(4px);
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    z-index: 1000;
+    padding: 20px;
+}
+
+.review-modal-box {
+    /* background: var(--surface, #14141c); */
+    border: 1px solid rgba(255, 255, 255, 0.08);
+    border-radius: 16px;
+    padding: 24px;
+    max-width: 400px;
+    width: 100%;
+    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
+}
