+
+.admin-venue-owner {
+    font-size: .8rem;
+    color: var(--text-faint);
+    margin-top: 2px;
+}
+
+.admin-venue-meta {
+    display: flex;
+    flex-direction: column;
+    gap: 4px;
+    font-size: .84rem;
+    color: var(--text-muted);
