+}
+
+.owner-sidebar-back:hover {
+    color: var(--white);
+}
+
+/* ===== Mobile header ===== */
+.owner-mobile-header {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    padding: 16px 20px;
+    background: var(--bg-secondary);
